# Copy to .env (git-ignored). Values below are placeholders for local development only.
NODE_ENV=development
DATABASE_URL=postgresql://hermes:hermes_dev_only@127.0.0.1:5433/hermes
# Must be a pinned tag (not :latest) in dev, and an @sha256 digest in production.
# hermes-stub is a local test stand-in. For a real instance use the pinned official image, e.g.
# nousresearch/hermes-agent@sha256:276d44685c65c0cb2a25f190b63c65c8906f9dc76486fb1c05ae71b5826bda08
HERMES_IMAGE=hermes-stub:0.2.0
# Operator API token (>= 24 chars). Generate with: openssl rand -hex 24
ADMIN_TOKEN=
# Source of every instance's API key (>= 32 chars). Generate with: openssl rand -hex 32
HERMES_MASTER_KEY=
# OCI runtime for tenant containers: runc (default) or runsc (gVisor).
HERMES_RUNTIME=runc
# Tenant volume quotas (XFS project quotas on Docker's data root). `off` is for local development and
# tests only and is rejected when NODE_ENV=production.
HERMES_DISK_QUOTA=off
# How often disk usage events are evaluated (default 300000 = 5 minutes).
# HERMES_DISK_CHECK_INTERVAL_MS=300000
# Host egress ruleset (ops/egress/). `off` is for local development and tests only and is rejected when
# NODE_ENV=production. With `enforce`, startup runs a canary container from HERMES_CANARY_IMAGE, which
# must be pinned by digest (name@sha256:<64 hex>).
HERMES_EGRESS_POLICY=off
# HERMES_CANARY_IMAGE=
# Optional IPv4 address of the host that the canary must not be able to reach.
# HERMES_CANARY_PRIVATE_IP=
PORT=3000
# The API binds to loopback only; do not expose it publicly.
DOCKER_SOCKET_PATH=/var/run/docker.sock
