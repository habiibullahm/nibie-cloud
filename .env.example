# Copy to .env (git-ignored). Values below are placeholders for local development only.
NODE_ENV=development
DATABASE_URL=postgresql://hermes:hermes_dev_only@127.0.0.1:5433/hermes
# Must be a pinned tag (not :latest) in dev, and an @sha256 digest in production.
# hermes-stub is a local test stand-in. For a real instance use the pinned official image, e.g.
# nousresearch/hermes-agent@sha256:276d44685c65c0cb2a25f190b63c65c8906f9dc76486fb1c05ae71b5826bda08
HERMES_IMAGE=hermes-stub:0.2.0
# Operator API token (>= 24 chars). Generate with: openssl rand -hex 24
ADMIN_TOKEN=
# Source of every instance's API key (>= 32 chars). Generate with: openssl rand -hex 32
HERMES_MASTER_KEY=
# OCI runtime for tenant containers: runc (default) or runsc (gVisor).
HERMES_RUNTIME=runc
PORT=3000
# The API binds to loopback only; do not expose it publicly.
DOCKER_SOCKET_PATH=/var/run/docker.sock
