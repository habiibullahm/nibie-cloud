# Hermes Cloud dashboard (apps/web). Copy to .env.local.

# "mock" (default): everything runs on in-browser sample data, no backend needed.
# "live": instance endpoints go to the backend through the server-side dev bridge
#         (src/app/api/hermes/[...path]/route.ts). Everything else stays mocked. Local development only.
# "customer": the browser calls the backend customer API directly with the signed-in user's Supabase
#         token (needs the two Supabase variables below and NEXT_PUBLIC_HERMES_API_URL). Instances,
#         /me and /plans are real; the rest stays labelled preview data. Set at build time.
NEXT_PUBLIC_HERMES_API_MODE=mock

# Customer mode only: public origin of the backend, e.g. https://api.cloud.nibie.app (no path).
# The backend must list the dashboard origin in DASHBOARD_ORIGIN for CORS.
NEXT_PUBLIC_HERMES_API_URL=

# Live mode only. Server-side; never exposed to the browser.
HERMES_API_URL=http://127.0.0.1:3000
HERMES_ADMIN_TOKEN=
HERMES_DEV_TENANT_ID=
# The backend has no GET /plans yet, so every deploy uses this real plan row.
HERMES_DEV_PLAN_ID=
# The dev bridge refuses to run in a production build unless this is 1.
HERMES_ALLOW_DEV_BRIDGE=0

# Real sign-in. Both are public values (the project URL and the publishable key, never a secret or
# service_role key). Leave them empty to keep the auth screens a preview. Set at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
