# Public contact address shown on the site (footer, /kontak, beta-access button).
# Set it as a build variable in Cloudflare Workers Builds. Never commit a real address:
# the repository is public. When empty, the site falls back to Telegram only.
NEXT_PUBLIC_CONTACT_EMAIL=

# Self-service sign-up is open by default: the "Daftar" and "Pilih ..." buttons link to /dashboard/register.
# Set "false" to close it (buttons go back to the invite request by email or Telegram).
# Build variable: changing it needs a rebuild.
NEXT_PUBLIC_SIGNUP_OPEN=

# Where the dashboard lives, for the "Daftar" and "Masuk" links. Empty: "/dashboard" on the same origin (production).
# Local development, where the dashboard runs on its own port: http://localhost:3500/dashboard
NEXT_PUBLIC_DASHBOARD_URL=

# Cloudflare Turnstile site key (public) for the waiting-list form: the same widget as the dashboard sign-up. The backend
# checks the token with TURNSTILE_SECRET_KEY (required there in production while the waiting list is on). Build variable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
