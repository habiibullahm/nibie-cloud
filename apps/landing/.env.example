# Public contact address shown on the site (footer, /kontak, beta-access button).
# Set it as a build variable in Cloudflare Workers Builds. Never commit a real address:
# the repository is public. When empty, the site falls back to Telegram only.
NEXT_PUBLIC_CONTACT_EMAIL=

# Self-service sign-up is open by default: the "Daftar" and "Pilih ..." buttons link to /dashboard/register.
# Set "false" to close it (buttons go back to the invite request by email or Telegram).
# Build variable: changing it needs a rebuild.
NEXT_PUBLIC_SIGNUP_OPEN=
