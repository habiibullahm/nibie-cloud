# /etc/hermes-cloud/backend.env  (chmod 600). NEVER commit the real file, never paste it into a chat.
# Docker Compose env_file format: one KEY=VALUE per line, no spaces around "=", no quotes, and values must
# not contain " #" or "$". Use letters and digits for passwords (a password with @ % ! $ breaks the
# database URL and Compose interpolation; percent-encode if you must use symbols).

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# --- Core secrets. Generate on the VPS and copy to a password manager first. ---
# openssl rand -hex 24
ADMIN_TOKEN=
# openssl rand -hex 32  (changing it later turns running instances DEGRADED)
HERMES_MASTER_KEY=

# --- Supabase ---
# Session pooler (the VPS has no IPv6), user postgres.<project-ref>, ending with ?schema=hermes
DATABASE_URL=
SUPABASE_URL=https://<project-ref>.supabase.co
DASHBOARD_ORIGIN=https://cloud.nibie.app
# Comma-separated beta emails. Empty means nobody can create an instance.
BETA_ALLOWED_EMAILS=
MAX_INSTANCES_PER_TENANT=1

# --- Redis (compose.prod.yaml). The same password is used in two places. ---
# openssl rand -hex 24
REDIS_PASSWORD=
REDIS_URL=redis://:SAME_PASSWORD_AS_ABOVE@127.0.0.1:6380

# --- Tenant runtime ---
# Must be name@sha256:<digest> when NODE_ENV=production.
HERMES_IMAGE=nousresearch/hermes-agent@sha256:276d44685c65c0cb2a25f190b63c65c8906f9dc76486fb1c05ae71b5826bda08
HERMES_RUNTIME=runc
HERMES_DISK_QUOTA=enforce
HERMES_EGRESS_POLICY=enforce
# Small image with sh and nc, pinned by digest and already pulled.
HERMES_CANARY_IMAGE=
# The VPS's private IPv4 (hostname -I). Optional but recommended.
HERMES_CANARY_PRIVATE_IP=

# --- Read by docker compose, not by the application ---
# stat -c %g /var/run/docker.sock
DOCKER_GID=
BACKEND_TAG=current

# --- Stored-secret encryption (milestone C, on main; required when NODE_ENV=production from that milestone on) ---
# Base64 of 32 random bytes: openssl rand -base64 32. Keep a backup in the password manager: without this
# key stored secrets can never be opened again. The first VPS deployment (milestones A and B only) ignored it.
SECRETS_KEK=

# --- Outbound email over SumoPod SMTP (not used yet: the first sender is milestone D). ---
# Leave all five empty to keep email off; set all five or none. Placeholders only, never a real password.
SUMOPOD_SMTP_HOST=
SUMOPOD_SMTP_PORT=
SUMOPOD_SMTP_USER=
SUMOPOD_SMTP_PASS=
# Bare sender address on the domain verified in SumoPod, e.g. no-reply@<your-domain>
MAIL_FROM=
