# /etc/hermes-cloud/backend.env  (chmod 600). NEVER commit the real file, never paste it into a chat.
# Docker Compose env_file format: one KEY=VALUE per line, no spaces around "=", no quotes, and values must
# not contain " #" or "$". Use letters and digits for passwords (a password with @ % ! $ breaks the
# database URL and Compose interpolation; percent-encode if you must use symbols).

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# --- Core secrets. Generate on the VPS and copy to a password manager first. ---
# openssl rand -hex 24
ADMIN_TOKEN=
# openssl rand -hex 32  (changing it later turns running instances DEGRADED)
HERMES_MASTER_KEY=

# --- Supabase ---
# Session pooler (the VPS has no IPv6), user postgres.<project-ref>, ending with ?schema=hermes
DATABASE_URL=
SUPABASE_URL=https://<project-ref>.supabase.co
DASHBOARD_ORIGIN=https://cloud.nibie.app
# Comma-separated beta emails. Empty means nobody can create an instance.
BETA_ALLOWED_EMAILS=
MAX_INSTANCES_PER_TENANT=1

# --- Redis (compose.prod.yaml). The same password is used in two places. ---
# openssl rand -hex 24
REDIS_PASSWORD=
REDIS_URL=redis://:SAME_PASSWORD_AS_ABOVE@127.0.0.1:6380

# --- Tenant runtime ---
# Must be name@sha256:<digest> when NODE_ENV=production.
HERMES_IMAGE=nousresearch/hermes-agent@sha256:276d44685c65c0cb2a25f190b63c65c8906f9dc76486fb1c05ae71b5826bda08
HERMES_RUNTIME=runc
# Required if HERMES_RUNTIME=runsc (gVisor): Docker's embedded resolver is not reachable from inside a
# runsc sandbox, and HostConfig.Dns alone is not enough either (verified 2026-11-14) -- these resolvers
# are bind-mounted as the tenant's own resolv.conf instead, seeded by HERMES_CANARY_IMAGE below. Space-
# or comma-separated IPv4 addresses. A private resolver also needs a RESOLVERS entry in
# /etc/hermes-egress/egress.conf.
# HERMES_DNS_RESOLVERS=1.1.1.1,9.9.9.9
HERMES_DISK_QUOTA=enforce
HERMES_EGRESS_POLICY=enforce
# Small image with sh and nc, pinned by digest and already pulled. Required when HERMES_EGRESS_POLICY=
# enforce or HERMES_RUNTIME=runsc (it also seeds the tenant resolv.conf volume in the runsc case).
HERMES_CANARY_IMAGE=
# The VPS's private IPv4 (hostname -I). Optional but recommended.
HERMES_CANARY_PRIVATE_IP=

# --- Read by docker compose, not by the application ---
# stat -c %g /var/run/docker.sock
DOCKER_GID=
BACKEND_TAG=current

# --- Stored-secret encryption (milestone C, on main; required when NODE_ENV=production from that milestone on) ---
# Base64 of 32 random bytes: openssl rand -base64 32. Keep a backup in the password manager: without this
# key stored secrets can never be opened again. The first VPS deployment (milestones A and B only) ignored it.
SECRETS_KEK=

# --- Outbound email over SumoPod SMTP (used by the milestone D billing emails). ---
# Leave all five empty to keep email off; set all five or none. Placeholders only, never a real password.
SUMOPOD_SMTP_HOST=
SUMOPOD_SMTP_PORT=
SUMOPOD_SMTP_USER=
SUMOPOD_SMTP_PASS=
# Bare sender address on the domain verified in SumoPod, e.g. no-reply@<your-domain>
MAIL_FROM=

# --- Duitku POP billing (milestone D). Leave all three empty to keep billing off; set all three or none. ---
# Sandbox credentials until Duitku verifies the production merchant. Never commit real values.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# sandbox (default) or production
DUITKU_ENV=sandbox
# https://api.cloud.nibie.app/api/v1/billing/duitku/callback
DUITKU_CALLBACK_URL=

# --- Admin dashboard (phase A, read-only). Comma-separated emails allowed on /api/v1/admin/*. Empty means nobody. ---
ADMIN_EMAILS=

# --- Which payment gateway is live: sumopod (default), duitku or both. The chosen gateway's variables must be
# set, otherwise the backend refuses to start. ---
BILLING_GATEWAY=sumopod

# --- SumoPod Managed Payment. Set all three or none. Never commit real values. ---
# sandbox (default) or production (needs NODE_ENV=production and a SumoPod account that passed KYC)
SUMOPOD_ENV=sandbox
SUMOPOD_API_KEY=
# Shared secret that SumoPod sends with each webhook; copy it from the SumoPod dashboard
SUMOPOD_WEBHOOK_TOKEN=
# https://api.cloud.nibie.app/api/v1/billing/sumopod/webhook (the same URL is also set in the SumoPod dashboard)
SUMOPOD_CALLBACK_URL=
