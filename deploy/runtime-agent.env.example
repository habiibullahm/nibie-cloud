NODE_ENV=production
HERMES_BACKEND_IMAGE=
DOCKER_GID=
HERMES_AGENT_NAME=jkt-2
# Actual private overlay address. Use 127.0.0.1 when reaching the agent over an SSH tunnel.
HERMES_AGENT_BIND=127.0.0.1
HERMES_AGENT_PORT=9443
HERMES_AGENT_TLS_DIR=/etc/hermes-cloud/agent-tls
HERMES_AGENT_QUOTA_FILE=/var/lib/hermes-quota-policy/desired.json
HERMES_RUNTIME=runsc
HERMES_DISK_QUOTA=enforce
HERMES_EGRESS_POLICY=enforce
HERMES_DNS_RESOLVERS=1.1.1.1,9.9.9.9
HERMES_CANARY_IMAGE=
