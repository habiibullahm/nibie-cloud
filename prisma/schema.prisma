generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstanceStatus {
  PENDING
  PROVISIONING
  CONFIGURING
  STARTING
  ACTIVE
  DEGRADED
  STOPPED // internal: customer-initiated stop (not in PRD 10.2; see ADR)
  FAILED
  DELETING
  DELETED
}

model Tenant {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  instances Instance[]
}

/// Resource limits only. Pricing is intentionally absent (PRD 5.2: not approved).
model Plan {
  id         String     @id @default(uuid()) @db.Uuid
  slug       String     @unique
  cpuMillis  Int
  memoryMb   Int
  pids       Int
  storageMb  Int
  instances  Instance[]
}

model RuntimeNode {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  region      String
  schedulable Boolean    @default(true)
  instances   Instance[]
}

model Instance {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @db.Uuid
  planId              String         @db.Uuid
  nodeId              String         @db.Uuid
  name                String
  idempotencyKey      String
  status              InstanceStatus @default(PENDING)
  statusReason        String?
  image               String
  hostPort            Int?
  consecutiveFailures Int            @default(0)
  recoveryAttempts    Int            @default(0)
  nextRecoveryAt      DateTime?      @db.Timestamptz(3)
  lastHealthAt        DateTime?      @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?      @db.Timestamptz(3)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  node   RuntimeNode     @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  events InstanceEvent[]

  @@unique([tenantId, idempotencyKey])
  @@index([status])
  @@index([tenantId])
}

/// Append-only. Messages must be sanitized before insert (no secrets, no raw Docker errors).
model InstanceEvent {
  id         String   @id @default(uuid()) @db.Uuid
  instanceId String   @db.Uuid
  type       String
  message    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Restrict)

  @@index([instanceId, createdAt])
}
