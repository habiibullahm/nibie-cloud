generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstanceStatus {
  PENDING
  PROVISIONING
  CONFIGURING
  STARTING
  ACTIVE
  DEGRADED
  STOPPING // internal transitional state: serializes stop against start/restart/delete
  STOPPED // internal: customer-initiated stop (not in PRD 10.2; see ADR)
  FAILED
  DELETING
  DELETED
}

model Tenant {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  instances Instance[]
  members   TenantMember[]
}

/// Customer identity. `id` is the Supabase Auth user id (the token's `sub`); it is not generated here.
model User {
  id        String         @id @db.Uuid
  email     String
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  members   TenantMember[]
}

/// PRD 14 has roles; only OWNER exists for the beta.
enum TenantRole {
  OWNER
}

model TenantMember {
  tenantId String     @db.Uuid
  userId   String     @db.Uuid
  role     TenantRole @default(OWNER)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([tenantId, userId])
  /// Beta: one user = one tenant. Drop this constraint when team membership arrives.
  @@unique([userId])
}

/// Resource limits only. Pricing is intentionally absent (PRD 5.2: not approved).
model Plan {
  id        String     @id @default(uuid()) @db.Uuid
  slug      String     @unique
  name      String
  active    Boolean    @default(true)
  cpuMillis Int
  memoryMb  Int
  pids      Int
  storageMb Int
  instances Instance[]
}

model RuntimeNode {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  region      String
  schedulable Boolean    @default(true)
  instances   Instance[]
}

model Instance {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @db.Uuid
  planId              String         @db.Uuid
  nodeId              String         @db.Uuid
  name                String
  idempotencyKey      String
  status              InstanceStatus @default(PENDING)
  statusReason        String?
  image               String
  hostPort            Int?
  consecutiveFailures Int            @default(0)
  recoveryAttempts    Int            @default(0)
  nextRecoveryAt      DateTime?      @db.Timestamptz(3)
  lastHealthAt        DateTime?      @db.Timestamptz(3)
  /// Lease for the in-flight operation (provision/start/stop/delete/recovery). Renewed by a
  /// heartbeat; the stale reaper only touches rows whose lease has expired.
  operationOwner      String?        @db.Uuid
  leaseExpiresAt      DateTime?      @db.Timestamptz(3)
  /// Written only by the DiskMonitor: last measured volume usage and its level (ok | warning | full).
  diskUsedBytes       BigInt?
  diskLevel           String         @default("ok")
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?      @db.Timestamptz(3)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  node   RuntimeNode     @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  events InstanceEvent[]

  @@unique([tenantId, idempotencyKey])
  @@index([status])
  @@index([status, leaseExpiresAt])
  @@index([tenantId])
}

/// Append-only. Messages must be sanitized before insert (no secrets, no raw Docker errors).
model InstanceEvent {
  id         String   @id @default(uuid()) @db.Uuid
  instanceId String   @db.Uuid
  type       String
  message    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Restrict)

  @@index([instanceId, createdAt])
}
