generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstanceStatus {
  PENDING
  PROVISIONING
  CONFIGURING
  STARTING
  ACTIVE
  DEGRADED
  STOPPING // internal transitional state: serializes stop against start/restart/delete
  STOPPED // internal: customer-initiated stop (not in PRD 10.2; see ADR)
  FAILED
  DELETING
  DELETED
}

model Tenant {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  instances     Instance[]
  members       TenantMember[]
  secrets       Secret[]
  subscriptions Subscription[]
  /// NibieRouter user for this tenant (created lazily by the NibieRouter provisioner); the customer never signs in there.
  routerUserId  String?
  creditGrants  CreditGrant[]
  tickets       SupportTicket[]
  wallet        Wallet?
  walletEntries WalletEntry[]
  walletTopups  WalletTopup[]
  invoices      Invoice[]
}

/// Customer identity. `id` is the Supabase Auth user id (the token's `sub`); it is not generated here.
model User {
  id        String         @id @db.Uuid
  email     String
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  members   TenantMember[]
}

/// PRD 14 has roles; only OWNER exists for the beta.
enum TenantRole {
  OWNER
}

model TenantMember {
  tenantId String     @db.Uuid
  userId   String     @db.Uuid
  role     TenantRole @default(OWNER)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([tenantId, userId])
  /// Beta: one user = one tenant. Drop this constraint when team membership arrives.
  @@unique([userId])
}

/// Resource limits, plus an optional monthly price. `monthlyPriceIdr` null means the plan is not for sale
/// (PRD 5.2: pricing is not approved); prices are set by an explicit operator step, never by a migration.
model Plan {
  id                 String         @id @default(uuid()) @db.Uuid
  slug               String         @unique
  name               String
  active             Boolean        @default(true)
  cpuMillis          Int
  memoryMb           Int
  pids               Int
  storageMb          Int
  monthlyPriceIdr    Int?
  /// One-time NibieRouter credit granted with the first payment, in nano-USD (US$1 = 1_000_000_000). Null: none.
  includedCreditNano BigInt?
  /// Stock of a priced plan, set from the admin panel: how many instances plus open purchases it may have. Null: no limit.
  /// Ignored on the free plan, which FREE_BETA_SLOTS limits.
  stockLimit         Int?
  instances          Instance[]
  subscriptions      Subscription[]
}

model RuntimeNode {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  region      String
  schedulable Boolean    @default(true)
  instances   Instance[]
}

model Instance {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @db.Uuid
  planId              String         @db.Uuid
  nodeId              String         @db.Uuid
  name                String
  idempotencyKey      String
  status              InstanceStatus @default(PENDING)
  statusReason        String?
  image               String
  hostPort            Int?
  consecutiveFailures Int            @default(0)
  recoveryAttempts    Int            @default(0)
  nextRecoveryAt      DateTime?      @db.Timestamptz(3)
  lastHealthAt        DateTime?      @db.Timestamptz(3)
  /// Lease for the in-flight operation (provision/start/stop/delete/recovery). Renewed by a
  /// heartbeat; the stale reaper only touches rows whose lease has expired.
  operationOwner      String?        @db.Uuid
  leaseExpiresAt      DateTime?      @db.Timestamptz(3)
  /// Written only by the DiskMonitor: last measured volume usage and its level (ok | warning | full).
  diskUsedBytes       BigInt?
  diskLevel           String         @default("ok")
  /// Bumped whenever provider or Telegram configuration changes; `appliedRevision` is what the running
  /// container was created with. A gap makes the next restart recreate the container (volume kept).
  configRevision      Int            @default(0)
  appliedRevision     Int            @default(0)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?      @db.Timestamptz(3)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan         Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  node         RuntimeNode         @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  events       InstanceEvent[]
  provider     ProviderConfig?
  telegram     TelegramConnection?
  subscription Subscription?
  tickets      SupportTicket[]

  @@unique([tenantId, idempotencyKey])
  @@index([status])
  @@index([status, leaseExpiresAt])
  @@index([tenantId])
}

/// Append-only. Messages must be sanitized before insert (no secrets, no raw Docker errors).
model InstanceEvent {
  id         String   @id @default(uuid()) @db.Uuid
  instanceId String   @db.Uuid
  type       String
  message    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Restrict)

  @@index([instanceId, createdAt])
}

/// Envelope-encrypted credential (PRD 7.4). Holds ciphertext, the wrapped data key and the KEK version;
/// never plaintext. `keyHint` is the last four characters at most. Read back only by the worker.
model Secret {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  purpose    String
  ciphertext String
  iv         String
  tag        String
  wrappedKey String
  wrapIv     String
  wrapTag    String
  kekVersion Int
  keyHint    String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  rotatedAt  DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  provider ProviderConfig?
  telegram TelegramConnection?

  @@index([tenantId])
  @@index([kekVersion])
}

enum ProviderKind {
  BYOK
  NIBIEROUTER
}

enum IntegrationStatus {
  UNTESTED
  OK
  FAILED
}

/// One provider per instance for the beta. The key lives in `Secret`, referenced by `secretId`.
model ProviderConfig {
  id            String            @id @default(uuid()) @db.Uuid
  instanceId    String            @unique @db.Uuid
  kind          ProviderKind
  baseUrl       String
  model         String
  secretId      String            @unique @db.Uuid
  status        IntegrationStatus @default(UNTESTED)
  lastTestedAt  DateTime?         @db.Timestamptz(3)
  lastErrorCode String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  secret   Secret   @relation(fields: [secretId], references: [id], onDelete: Restrict)
}

/// One Telegram bot per instance. `botId` is unique across tenants: one bot token, one tenant (PRD 9).
model TelegramConnection {
  id             String            @id @default(uuid()) @db.Uuid
  instanceId     String            @unique @db.Uuid
  secretId       String            @unique @db.Uuid
  botId          String            @unique
  botUsername    String
  allowedUserIds String[]
  status         IntegrationStatus @default(UNTESTED)
  /// Set when the bot answered the verify message; `needs_start` when the user has not started the bot yet.
  lastErrorCode  String?
  verifiedAt     DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  secret   Secret   @relation(fields: [secretId], references: [id], onDelete: Restrict)
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  GRACE
  SUSPENDED
  ENDED
}

/// One paid hosting subscription per instance (PRD 10). The instance row is created when the first payment
/// is verified; until then `instanceId` is null and `intendedName` carries what the customer asked for.
model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  planId            String             @db.Uuid
  instanceId        String?            @unique @db.Uuid
  intendedName      String
  /// Checkout `Idempotency-Key`, bound to (intendedName, planId); null for rows not created by a checkout.
  idempotencyKey    String?
  status            SubscriptionStatus @default(PENDING_PAYMENT)
  currentPeriodEnd  DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd Boolean            @default(false)
  graceEndsAt       DateTime?          @db.Timestamptz(3)
  suspendedAt       DateTime?          @db.Timestamptz(3)
  retentionEndsAt   DateTime?          @db.Timestamptz(3)
  /// Set when a verified payment reinstates a suspended subscription, cleared once the instance was started
  /// again. A crash in between is repaired by the billing tick.
  restartPending    Boolean            @default(false)
  /// Renew from the wallet balance near the end of the period (owner decision: on by default, the customer can turn it off).
  autoRenew         Boolean            @default(true)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan     Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  instance Instance?       @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  payments Payment[]
  notices  BillingNotice[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([status, currentPeriodEnd])
}

enum PaymentPurpose {
  NEW
  RENEWAL
}

enum PaymentMethod {
  QRIS
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

/// One payment-provider invoice (SumoPod today; older rows may be Duitku). `merchantOrderId` is generated here (UUID based, 35 chars).
model Payment {
  id              String         @id @default(uuid()) @db.Uuid
  subscriptionId  String         @db.Uuid
  merchantOrderId String         @unique
  amountIdr       Int
  purpose         PaymentPurpose
  status          PaymentStatus  @default(PENDING)
  /// How it was paid: QRIS through the gateway, or from the wallet balance (then no gateway reference).
  method          PaymentMethod  @default(QRIS)
  reference       String?
  paymentUrl      String?
  resultCode      String?
  expiresAt       DateTime       @db.Timestamptz(3)
  paidAt          DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invoice      Invoice?

  @@index([status, expiresAt])
}

/// Append-only record of every authenticated payment webhook. The unique key on (order, reference,
/// result code) is what makes a redelivered webhook a no-op. No raw body and no signature are stored.
model PaymentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  merchantOrderId String
  reference       String
  resultCode      String
  amountIdr       Int
  outcome         String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([merchantOrderId, reference, resultCode])
}

/// Written after an email was sent successfully: one row per kind and period, so a repeated tick never
/// sends the same reminder twice.
model BillingNotice {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @db.Uuid
  kind           String
  periodEnd      DateTime @db.Timestamptz(3)
  sentAt         DateTime @default(now()) @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, kind, periodEnd])
}

/// Nibie Cloud balance (saldo) of a tenant, in whole rupiah. Changed only together with a `WalletEntry` in one
/// transaction, under a row lock; a database CHECK keeps it from going below zero. Non-refundable.
model Wallet {
  tenantId   String   @id @db.Uuid
  balanceIdr Int      @default(0)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

enum WalletEntryKind {
  TOPUP
  HOSTING
  AUTO_RENEW
  AI_CREDIT
  ADMIN_CREDIT
  ADMIN_DEBIT
}

/// Append-only ledger of every wallet movement (signed amount). The unique (kind, refId) makes each movement happen at
/// most once: a top-up is credited once per `WalletTopup.id`, an admin adjustment once per its generated id.
model WalletEntry {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  amountIdr       Int
  kind            WalletEntryKind
  refId           String
  balanceAfterIdr Int
  /// Short reason, shown to the customer. Admin reasons are kept in AuditLog, not here.
  note            String?
  actorEmail      String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([kind, refId])
  @@index([tenantId, createdAt])
}

/// One SumoPod invoice that tops up a wallet. Kept apart from `Payment` (which always belongs to a subscription); the
/// webhook looks here when no `Payment` has the order id. Order ids start with `nw-`.
model WalletTopup {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  merchantOrderId String        @unique
  amountIdr       Int
  status          PaymentStatus @default(PENDING)
  idempotencyKey  String
  reference       String?
  paymentUrl      String?
  resultCode      String?
  expiresAt       DateTime      @db.Timestamptz(3)
  paidAt          DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice?

  @@unique([tenantId, idempotencyKey])
  @@index([status, expiresAt])
}

enum InvoiceKind {
  HOSTING_NEW
  HOSTING_RENEWAL
  TOPUP
}

/// One per paid Payment or paid WalletTopup, issued in the transaction that marks it paid. Never changed afterwards:
/// plan and instance names are copied at issue time. `number` is INV/<year>/<month>/<seq>, month in Asia/Jakarta.
model Invoice {
  id            String      @id @default(uuid()) @db.Uuid
  number        String      @unique
  tenantId      String      @db.Uuid
  kind          InvoiceKind
  planName      String?
  instanceName  String?
  amountIdr     Int
  paidAt        DateTime    @db.Timestamptz(3)
  paymentId     String?     @unique @db.Uuid
  walletTopupId String?     @unique @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  walletTopup WalletTopup? @relation(fields: [walletTopupId], references: [id], onDelete: Restrict)

  @@index([tenantId, paidAt])
}

/// Last invoice sequence used per month ("2026/11"); bumped in the issuing transaction, so numbers have no gaps.
model InvoiceCounter {
  period String @id
  last   Int
}

enum CreditGrantStatus {
  PENDING
  DONE
}

/// The one-time NibieRouter credit of a subscription. NibieRouter has no idempotency for credit grants, so this
/// row is the exactly-once guard: `attempts` is raised before the call, and a retry after an ambiguous failure
/// first looks for `note` in the router's balance history before posting again.
model CreditGrant {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  subscriptionId   String            @unique @db.Uuid
  amountNano       BigInt
  note             String
  status           CreditGrantStatus @default(PENDING)
  attempts         Int               @default(0)
  balanceAfterNano BigInt?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

enum RouterProvisioningStatus {
  PENDING
  DONE
}

/// Per instance: has the NibieRouter key been created and attached (and the credit granted) yet. Created when
/// a paid instance is created, retried by the billing tick until DONE. An instance that already has a provider
/// configuration (the customer chose their own) is marked DONE without touching it.
model RouterProvisioning {
  instanceId     String                   @id @db.Uuid
  tenantId       String                   @db.Uuid
  subscriptionId String?                  @db.Uuid
  status         RouterProvisioningStatus @default(PENDING)
  attempts       Int                      @default(0)
  /// Short machine code of the last failure, never provider text.
  lastError      String?
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
}

/// Append-only record of what an admin did (PRD 14). `detail` is a short JSON summary, never a secret:
/// the admin API must not store tokens, keys or request bodies. Reads are the only way to answer
/// "who changed this and why".
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Supabase email of the admin who acted. Taken from the verified token, never from the request.
  actorEmail String
  /// Route and method, e.g. `POST /instances/:id/restart`.
  action     String
  /// What the action was aimed at (`instance`, `plan`, `subscription`); null for reads and system actions.
  targetType String?
  targetId   String?  @db.Uuid
  /// Free-text justification, required for every mutating action.
  reason     String?
  /// Small JSON object with the outcome (statuses, counts). Never a credential.
  detail     Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorEmail, createdAt])
  @@index([targetId, createdAt])
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

/// An alert for the operator (the owner), kept so one condition is reported once and its recovery is reported once.
/// `dedupeKey` names the condition (for example `instance-degraded:<instanceId>`); it holds ids and fixed codes only,
/// never customer text or secrets. `resolvedAt` null means the condition is still open.
model OperatorAlert {
  id          String        @id @default(uuid()) @db.Uuid
  dedupeKey   String        @unique
  severity    AlertSeverity
  title       String
  detail      String        @default("")
  firstSeenAt DateTime      @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime      @default(now()) @db.Timestamptz(3)
  /// Null until a message was delivered; a failed delivery leaves it null so the next scan tries again.
  lastSentAt  DateTime?     @db.Timestamptz(3)
  sendCount   Int           @default(0)
  resolvedAt  DateTime?     @db.Timestamptz(3)

  @@index([resolvedAt])
}

enum WaitlistStatus {
  /// Joined from the website, email not confirmed yet: not in the queue, not counted, never invited.
  UNCONFIRMED
  WAITING
  INVITED
  REGISTERED
}

/// Beta waiting list, filled from the public website when the free slots are used. A new entry is UNCONFIRMED until the
/// person clicks the confirmation link sent to that address (double opt-in); only then is it WAITING and counted. The
/// platform invites the oldest WAITING entry by email whenever a free slot opens (no manual step). An INVITED entry holds one slot until
/// `inviteExpiresAt`; after that it holds nothing and is not invited again (the person may still take a free slot
/// like anyone else). `email` is stored lowercase, trimmed and unique. Row level security is enabled on this table
/// (the backend connects as the table owner; nothing else may read it, and the Supabase Data API must not expose it).
model WaitlistEntry {
  id               String         @id @default(uuid()) @db.Uuid
  email            String         @unique
  name             String
  useCase          String
  status           WaitlistStatus @default(UNCONFIRMED)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  /// SHA-256 (hex) of the confirmation token; the token itself is only in the email. Never selected for display.
  confirmTokenHash String?        @unique
  confirmSentAt    DateTime?      @db.Timestamptz(3)
  confirmExpiresAt DateTime?      @db.Timestamptz(3)
  /// Confirmation emails sent for this entry; capped per address (`MAX_CONFIRM_SENDS`).
  confirmSends     Int            @default(0)
  confirmedAt      DateTime?      @db.Timestamptz(3)
  invitedAt        DateTime?      @db.Timestamptz(3)
  inviteExpiresAt  DateTime?      @db.Timestamptz(3)
  /// Invitation emails that failed to send; at 3 the entry is skipped (an unreachable address must not block the queue).
  inviteFailures   Int            @default(0)
  registeredAt     DateTime?      @db.Timestamptz(3)

  @@index([status, createdAt])
}

/// Accounts the operator has invited to the beta, next to the `BETA_ALLOWED_EMAILS` env list (an email in either place
/// counts). `email` is stored lowercase, trimmed and unique. A revoked invite keeps its row (`revokedAt` set) so the
/// history stays; inviting the address again clears it. Row level security is enabled on this table (the backend
/// connects as the table owner; nothing else may read it, and the Supabase Data API must not expose it).
model BetaInvite {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  note      String?
  /// Admin who added it (Supabase email from the verified token); null for rows made by hand.
  addedBy   String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
}

/// Admin API keys for scripts and the admin MCP server (`/api/v1/admin/mcp`). A key skips the MFA step, so only an admin
/// signed in at `aal2` can create or revoke one, and a key stops working when its creator leaves `ADMIN_EMAILS`. Only the
/// SHA-256 hash is stored (the key is 32 random bytes, so no salt is needed); the plaintext is shown once at creation.
/// Row level security is enabled (same reasoning as `BetaInvite`).
model AdminApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  /// First characters of the key, for recognising it in the list. Not enough to use it.
  prefix          String
  hash            String    @unique
  createdByUserId String    @db.Uuid
  createdByEmail  String
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  /// Null: no expiry (until revoked).
  expiresAt       DateTime? @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  lastUsedAt      DateTime? @db.Timestamptz(3)
}

/// Support contacts shown on the dashboard's Support page, set by an admin on the Pengaturan page (every change audited).
/// One row only (`id` 1, enforced by a check constraint). Public data: the public API returns it as is.
model SupportContact {
  id        Int      @id @default(1)
  /// WhatsApp number, digits only with the country code (e.g. 628...). Null: not offered.
  whatsapp  String?
  email     String?
  /// WhatsApp group invite link (https://chat.whatsapp.com/...). Null: not offered.
  groupUrl  String?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum TicketCategory {
  PAYMENT
  TECHNICAL
  ACCOUNT
  OTHER
}

/// OPEN: waiting for the team (new, or the customer wrote last). ANSWERED: the team wrote last. CLOSED: done; a new customer
/// message reopens it.
enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum TicketAuthor {
  CUSTOMER
  ADMIN
}

/// A support conversation opened by a customer on the dashboard's Support page and answered from the admin panel. Holds
/// customer-written text, so row level security is enabled (same reasoning as `BetaInvite`).
model SupportTicket {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @db.Uuid
  /// Email of the customer who opened it (from the verified token); replies are emailed there.
  createdByEmail String
  subject        String
  category       TicketCategory
  /// Optional: the instance the question is about. Kept null if that instance row is ever removed.
  instanceId     String?                @db.Uuid
  status         TicketStatus           @default(OPEN)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  lastMessageAt  DateTime               @default(now()) @db.Timestamptz(3)
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance       Instance?              @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  messages       SupportTicketMessage[]

  @@index([tenantId, lastMessageAt])
  @@index([status, lastMessageAt])
}

model SupportTicketMessage {
  id          String        @id @default(uuid()) @db.Uuid
  ticketId    String        @db.Uuid
  author      TicketAuthor
  authorEmail String
  body        String
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}
