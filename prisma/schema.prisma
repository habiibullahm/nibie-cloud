generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstanceStatus {
  PENDING
  PROVISIONING
  CONFIGURING
  STARTING
  ACTIVE
  DEGRADED
  STOPPING // internal transitional state: serializes stop against start/restart/delete
  STOPPED // internal: customer-initiated stop (not in PRD 10.2; see ADR)
  FAILED
  DELETING
  DELETED
}

model Tenant {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  instances Instance[]
  members   TenantMember[]
  secrets   Secret[]
}

/// Customer identity. `id` is the Supabase Auth user id (the token's `sub`); it is not generated here.
model User {
  id        String         @id @db.Uuid
  email     String
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  members   TenantMember[]
}

/// PRD 14 has roles; only OWNER exists for the beta.
enum TenantRole {
  OWNER
}

model TenantMember {
  tenantId String     @db.Uuid
  userId   String     @db.Uuid
  role     TenantRole @default(OWNER)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([tenantId, userId])
  /// Beta: one user = one tenant. Drop this constraint when team membership arrives.
  @@unique([userId])
}

/// Resource limits only. Pricing is intentionally absent (PRD 5.2: not approved).
model Plan {
  id        String     @id @default(uuid()) @db.Uuid
  slug      String     @unique
  name      String
  active    Boolean    @default(true)
  cpuMillis Int
  memoryMb  Int
  pids      Int
  storageMb Int
  instances Instance[]
}

model RuntimeNode {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  region      String
  schedulable Boolean    @default(true)
  instances   Instance[]
}

model Instance {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @db.Uuid
  planId              String         @db.Uuid
  nodeId              String         @db.Uuid
  name                String
  idempotencyKey      String
  status              InstanceStatus @default(PENDING)
  statusReason        String?
  image               String
  hostPort            Int?
  consecutiveFailures Int            @default(0)
  recoveryAttempts    Int            @default(0)
  nextRecoveryAt      DateTime?      @db.Timestamptz(3)
  lastHealthAt        DateTime?      @db.Timestamptz(3)
  /// Lease for the in-flight operation (provision/start/stop/delete/recovery). Renewed by a
  /// heartbeat; the stale reaper only touches rows whose lease has expired.
  operationOwner      String?        @db.Uuid
  leaseExpiresAt      DateTime?      @db.Timestamptz(3)
  /// Written only by the DiskMonitor: last measured volume usage and its level (ok | warning | full).
  diskUsedBytes       BigInt?
  diskLevel           String         @default("ok")
  /// Bumped whenever provider or Telegram configuration changes; `appliedRevision` is what the running
  /// container was created with. A gap makes the next restart recreate the container (volume kept).
  configRevision      Int            @default(0)
  appliedRevision     Int            @default(0)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?      @db.Timestamptz(3)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  node   RuntimeNode     @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  events InstanceEvent[]
  provider ProviderConfig?
  telegram TelegramConnection?

  @@unique([tenantId, idempotencyKey])
  @@index([status])
  @@index([status, leaseExpiresAt])
  @@index([tenantId])
}

/// Append-only. Messages must be sanitized before insert (no secrets, no raw Docker errors).
model InstanceEvent {
  id         String   @id @default(uuid()) @db.Uuid
  instanceId String   @db.Uuid
  type       String
  message    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Restrict)

  @@index([instanceId, createdAt])
}

/// Envelope-encrypted credential (PRD 7.4). Holds ciphertext, the wrapped data key and the KEK version;
/// never plaintext. `keyHint` is the last four characters at most. Read back only by the worker.
model Secret {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  purpose    String
  ciphertext String
  iv         String
  tag        String
  wrappedKey String
  wrapIv     String
  wrapTag    String
  kekVersion Int
  keyHint    String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  rotatedAt  DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  provider ProviderConfig?
  telegram TelegramConnection?

  @@index([tenantId])
  @@index([kekVersion])
}

enum ProviderKind {
  BYOK
  NIBIEROUTER
}

enum IntegrationStatus {
  UNTESTED
  OK
  FAILED
}

/// One provider per instance for the beta. The key lives in `Secret`, referenced by `secretId`.
model ProviderConfig {
  id            String            @id @default(uuid()) @db.Uuid
  instanceId    String            @unique @db.Uuid
  kind          ProviderKind
  baseUrl       String
  model         String
  secretId      String            @unique @db.Uuid
  status        IntegrationStatus @default(UNTESTED)
  lastTestedAt  DateTime?         @db.Timestamptz(3)
  lastErrorCode String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  secret   Secret   @relation(fields: [secretId], references: [id], onDelete: Restrict)
}

/// One Telegram bot per instance. `botId` is unique across tenants: one bot token, one tenant (PRD 9).
model TelegramConnection {
  id             String            @id @default(uuid()) @db.Uuid
  instanceId     String            @unique @db.Uuid
  secretId       String            @unique @db.Uuid
  botId          String            @unique
  botUsername    String
  allowedUserIds String[]
  status         IntegrationStatus @default(UNTESTED)
  /// Set when the bot answered the verify message; `needs_start` when the user has not started the bot yet.
  lastErrorCode  String?
  verifiedAt     DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  secret   Secret   @relation(fields: [secretId], references: [id], onDelete: Restrict)
}
