# Copy to .env.e2e (git-ignored). Names only: never put real values in this file or in the repository.

# --- T1: the dedicated Supabase TEST project (never the customer project) ---
E2E_SUPABASE_URL=
# Public value, ends up in the dashboard build.
E2E_SUPABASE_PUBLISHABLE_KEY=
# Service role / secret key. Used only by Node test helpers to create and delete test users.
E2E_SUPABASE_SECRET_KEY=
# One password for all test users in the test project. Make it long and random.
E2E_USER_PASSWORD=

# Optional overrides
# E2E_EMAIL_DOMAIN=example.com
# E2E_DATABASE_URL=postgresql://hermes:hermes_dev_only@127.0.0.1:5433/hermes_e2e
# E2E_REDIS_URL=redis://:hermes_dev_only@127.0.0.1:6380

# --- T2: read-only production smoke test ---
# PROD_BASE_URL=https://cloud.nibie.app
# PROD_API_URL=https://api.cloud.nibie.app
# Dedicated account without instances, not in BETA_ALLOWED_EMAILS.
PROD_SMOKE_EMAIL=
PROD_SMOKE_PASSWORD=
